# 复制为 .env 后按本地环境填写；.env 不入库
DATABASE_URL="postgresql://tip:tip@localhost:5432/tip?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3100
# Keycloak（M0 后期接入）
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM_STAFF="tip-staff"
KEYCLOAK_REALM_CUSTOMER="tip-customer"
KEYCLOAK_REALM_PARTNER="tip-partner"
# OSS / KMS（M3 前为本地/模拟）
OSS_ENDPOINT=""
KMS_KEY_ID=""

# 本机无 Docker 时可用嵌入式 PG15（无需系统安装）：
#   pnpm --filter @tip/api pg:start
#   DATABASE_URL="postgresql://tip:tip@127.0.0.1:55432/tip" pnpm --filter @tip/api migrate:deploy
# 集成测试（真实 PG15，审计链重启连续性 + 快照版本化）：
#   pnpm --filter @tip/api test:pg
