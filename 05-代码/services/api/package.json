{
  "name": "@tip/api",
  "version": "0.1.0",
  "private": true,
  "description": "透明身份规划平台后端（NestJS 模块化单体，M0 骨架）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && node dist/main.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pg:start": "node scripts/dev-pg.mjs start",
    "pg:stop": "node scripts/dev-pg.mjs stop",
    "migrate:deploy": "prisma migrate deploy",
    "test:pg": "DATABASE_URL=${DATABASE_URL:-postgresql://tip:tip@127.0.0.1:55432/tip} prisma migrate deploy && TIP_TEST_PG=1 DATABASE_URL=${DATABASE_URL:-postgresql://tip:tip@127.0.0.1:55432/tip} node --test \"dist/persistence/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "@tip/core": "workspace:*",
    "imapflow": "^2.3.0",
    "pdfjs-dist": "4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "embedded-postgres": "15.18.0-beta.17",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
